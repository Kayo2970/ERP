# Local Postfix submission target — the app hands every email off to Postfix
# running on this same machine, which is what actually relays out through the
# org's Google Workspace account. Defaults are correct for the standard
# "Postfix as a local relay" setup on the VPS and normally don't need changing.
SMTP_HOST=localhost
SMTP_PORT=25

# Must match (or be a verified Workspace "Send As" alias of) the Gmail account
# Postfix is authenticated as in /etc/postfix/sasl_passwd on the VPS, or
# Gmail's relay will reject the mail. The actual Gmail App Password is never
# set here — it lives only in Postfix's own config on the server.
ANNOUNCEMENT_FROM_EMAIL=leads@msruas.ac.in
ANNOUNCEMENT_FROM_NAME=LEADS Next Gen Centre

# Master key for encrypting every data/*.json collection at rest. Falls back
# to a hardcoded key baked into the source if unset — see src/lib/encryption.ts
# — which is NOT real protection since anyone with the source can read it.
# Set a real random value here (or via Admin -> Settings' key rotation) as
# soon as possible on any real deployment.
# DATA_ENCRYPTION_KEY=

# Rate limiting (src/lib/rate-limit.ts, src/proxy.ts) — all optional, sane
# defaults are used if unset. Only change these if you have a concrete
# reason to (e.g. a legitimate bulk-import script tripping the authenticated
# tier's limit).
# RATE_LIMIT_AUTH_MAX=20                    # per-IP requests per window on login/password-reset/OTP routes
# RATE_LIMIT_AUTH_WINDOW_MS=900000          # 15 minutes
# RATE_LIMIT_PUBLIC_MAX=60                  # per-IP requests per window on public routes (setup, form submission)
# RATE_LIMIT_PUBLIC_WINDOW_MS=60000         # 1 minute
# RATE_LIMIT_AUTHENTICATED_MAX=300          # per-IP requests per window on ordinary signed-in member actions
# RATE_LIMIT_AUTHENTICATED_WINDOW_MS=60000  # 1 minute
# RATE_LIMIT_AUTH_BACKOFF_BASE_MS=2000      # per-account exponential backoff base delay after a failed attempt
# RATE_LIMIT_AUTH_BACKOFF_MAX_MS=900000     # cap on that backoff (15 minutes)
# RATE_LIMIT_AUTH_BACKOFF_RESET_MS=3600000  # a failure streak older than this is forgotten (1 hour)
